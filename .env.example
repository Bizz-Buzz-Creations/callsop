# Copy to .env for local development (git-ignored). In production, set the same
# names in Netlify > Site configuration > Environment variables.

# MongoDB Atlas connection string for a database user that can access ONLY the
# "callsop" database (see README). Never commit the real value.
MONGODB_URI=

# At least 32 random characters; signs login tokens. Generate: openssl rand -base64 48
SESSION_SECRET=

# Optional. Database name (default: callsop). Keeps this app apart from your others.
# MONGODB_DB=callsop

# Only if the website and the API are on DIFFERENT domains:
# ALLOWED_ORIGIN=https://callsop.bbcfinsrv.com
# VITE_API_BASE_URL=https://your-site.netlify.app
